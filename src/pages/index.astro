---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/pages.css';

const posts = (await getCollection('blog'))
.sort(
(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
)
.slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

<main class="home">

  <section class="manifesto">
    <p>
      I learn in public because I forget in private </br>
      This is where I keep my thoughts while they’re still unfinished.
    </p>
  </section>

  <section class="now">
    <h2>Lately I’ve been thinking about</h2>
      <p style="color:#666; margin-bottom:1rem;">
        (things I touched this month)
      </p>
      <ul>
        {posts.map(post => (
          <li>
            <a href={`/blog/${post.id}/`}>
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
  </section>

  <section class="ritual">
    <h2>Question I’m stuck with</h2>
    <p style="font-style: italic;">
      How do you know when you actually understand something,
      and not just memorized the shape of it?
    </p>
  </section>

</main>

<Footer />
  </body>
</html>